# Copy this file to `.env` and fill in the values below.
# `.env` is gitignored — your secrets stay local.
#
# These are read by ./deploy at deploy time. They are NEVER baked into
# settings.json or the container image.

# Voice Live (Cognitive Services) API key.
# Only needed if you picked authMode='key' in ./setup. When using the
# default managed-identity mode (authMode='mi'), leave this blank.
# Find it in the Azure portal: your Voice Live account → Keys and Endpoint.
AZURE_VOICELIVE_API_KEY=
