#!/usr/bin/env bash
# Agent Template - deploy entrypoint.
# Runs the Node deploy orchestrator in setup-wizard/deploy.js.
# Must be run from the scaffolded project root.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WIZARD_DIR="$SCRIPT_DIR/setup-wizard"

if ! command -v node >/dev/null 2>&1; then
  echo "ERROR: Node.js is required. Install Node 18+ and re-run ./deploy." >&2
  exit 1
fi

if ! command -v npm >/dev/null 2>&1; then
  echo "ERROR: npm is required. Install Node.js (which bundles npm) and re-run." >&2
  exit 1
fi

if ! command -v az >/dev/null 2>&1; then
  echo "ERROR: Azure CLI (az) is required. Install: https://learn.microsoft.com/cli/azure/install-azure-cli" >&2
  exit 1
fi

if [[ ! -d "$WIZARD_DIR/node_modules" ]]; then
  echo "Installing deploy dependencies (first run only)..."
  ( cd "$WIZARD_DIR" && npm ci --silent --no-audit --no-fund ) \
    || ( cd "$WIZARD_DIR" && npm install --silent --no-audit --no-fund )
fi

# Run from the project root so deploy.js sees settings.json via process.cwd().
cd "$SCRIPT_DIR"
exec node "$WIZARD_DIR/deploy.js" "$@"
